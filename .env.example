# Vercel Blob (existing) — used for the /admin panel
BLOB_READ_WRITE_TOKEN=

# Admin panel password (falls back to a weak default if unset — always set this in production)
ADMIN_PASSWORD=

# Google Drive upload (OAuth, on behalf of the Google account that owns/can-edit the folder)
# 1. Create an OAuth Client ID (type: Desktop app) in Google Cloud Console.
# 2. Run: GOOGLE_OAUTH_CLIENT_ID=... GOOGLE_OAUTH_CLIENT_SECRET=... node scripts/get-google-refresh-token.mjs
# 3. Paste the printed refresh token below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# The target Drive folder's ID (from its URL: drive.google.com/drive/folders/<THIS_PART>)
GOOGLE_DRIVE_FOLDER_ID=
